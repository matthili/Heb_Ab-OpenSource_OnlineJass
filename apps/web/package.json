{
  "name": "@jass/web",
  "version": "0.0.0",
  "private": true,
  "description": "Spiel-SPA für Heb ab! — React 19 + Vite 8 + TanStack Router/Query. Lobby, Tisch, Auth-Flows. PWA-Polish kommt mit M11.",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/sync-web-cards.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/sync-web-cards.mjs",
    "build": "vite build && tsc -b --noEmit",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pwa:assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@jass/engine": "workspace:*",
    "@jass/shared-types": "workspace:*",
    "@jass/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "better-auth": "^1.7.7",
    "dompurify": "^3.4.16",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^16.6.6",
    "socket.io-client": "^4.8.4",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@jass/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
